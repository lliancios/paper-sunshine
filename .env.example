# Copy to .env.local for local dev. On Vercel, add these in Project Settings > Environment Variables.
# Never commit real keys. Every key is optional; without any AI key the app runs in demo mode.

# Password that protects the API routes (your AI quota). Leave empty only for local dev.
APP_PASSCODE=

# ---- AI providers (set at least one) -------------------------------------
# Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# DeepSeek (cheapest paid option, about US$0.01-0.05 per paper): https://platform.deepseek.com
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# OpenRouter (many free ":free" models, about 50 requests/day without credit)
OPENROUTER_API_KEY=
# SiliconFlow (Qwen / GLM / DeepSeek, cheap in Asia)
SILICONFLOW_API_KEY=
# SILICONFLOW_BASE_URL=https://api.siliconflow.com/v1
# Groq (free tier, fast; text only)
GROQ_API_KEY=
# Any other OpenAI-compatible endpoint
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_API_KEY=
# Which model does what is chosen in the app (設定 → 模型), e.g. "gemini:gemini-3.5-flash-lite"
# or "deepseek:deepseek-flash". Defaults: translate gemini-3.5-flash-lite, chat gemini-3.8-flash.

# ---- Scholarly metadata ---------------------------------------------------
# Free key from https://openalex.org/settings/api (needed for related papers)
OPENALEX_API_KEY=

# ---- Cross-device sync (optional; README「跨裝置同步」) -----------------------
# From your Supabase project: Project URL and the anon / publishable key.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Local layout testing only: MOCK_STYLE=zh fills demo translations with Chinese-shaped text
# MOCK_STYLE=zh
