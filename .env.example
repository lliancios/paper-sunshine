# Copy to .env.local for local dev. On Vercel, add these in Project Settings > Environment Variables.

# Google AI Studio key (never commit a real key)
GEMINI_API_KEY=
# Model used for translation + auto highlight, and for explanations/chat
GEMINI_MODEL_TRANSLATE=gemini-3.8-flash
GEMINI_MODEL_CHAT=gemini-3.8-flash

# Free key from https://openalex.org/settings/api
OPENALEX_API_KEY=

# Password that protects the API routes (your Gemini quota). Leave empty only for local dev.
APP_PASSCODE=
